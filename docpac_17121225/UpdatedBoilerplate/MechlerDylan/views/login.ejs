<%- include('./partials/header.ejs') %>
<body></body>
    <div id="content">
        <h1>Login</h1>
        <form id="loginForm" method="POST" action="/login">
            <label for="username" id="usernameLbl">Username:</label><br>
            <input type="text" id="username" name="username" required><br><br>
            <label for="password" id="passwordLbl">Password:</label><br>
            <input type="password" id="password" name="password" required><br><br>
            <input type="submit" id="loginSubmit" value="Submit">
        </form>
        <a href="/formbarOauth" id="oauthButton">
            <button>Formbar OAuth</button>
        </a>
    </div>
</body>
<%- include('./partials/footer.ejs') %>